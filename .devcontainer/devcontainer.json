{
  "name": "neovim",
  "image": "ghcr.io/funk66/devcontainers:latest",
  "workspaceFolder": "/home/ubuntu/.config/nvim",
  "containerUser": "ubuntu",
  "remoteUser": "ubuntu",
  "updateRemoteUserUID": false,
  "init": true,
  "mounts": [
    "source=nvim-data-${devcontainerId},target=/home/ubuntu/.local/share/nvim,type=volume",
    "source=nvim-state-${devcontainerId},target=/home/ubuntu/.local/state/nvim,type=volume",
    "source=opencode-state-${devcontainerId},target=/home/ubuntu/.local/state/opencode,type=volume"
  ],
  "remoteEnv": {
    "TAVILY_API_KEY": "${localEnv:TAVILY_API_KEY}",
    "SOFA_API_TOKEN": "${localEnv:SOFA_API_TOKEN}"
  },
  "runArgs": ["--add-host=coder.guirao.net:169.254.1.2"]
}
